# Copy to .env (git-ignored) and fill in. Never commit the real values.

# production (default) or sandbox
HENRRI_ENVIRONMENT=sandbox

# Either an API user (OAuth2 password grant)…
HENRRI_USERNAME=
HENRRI_PASSWORD=
# …or a developer client (POST /v1/users/authenticate)
# HENRRI_CLIENT_ID=
# HENRRI_CLIENT_SECRET=

# The signing secret from Henrri's webhook settings, to verify deliveries
HENRRI_WEBHOOK_SECRET=

# Tool selection and safety
# HENRRI_TOOLSETS=account,customers,documents,catalog,payments,revenues,webhooks
# HENRRI_READ_ONLY=1

# Where PDFs are saved (default: the system temp directory, /henrri)
# HENRRI_DOWNLOAD_DIR=
